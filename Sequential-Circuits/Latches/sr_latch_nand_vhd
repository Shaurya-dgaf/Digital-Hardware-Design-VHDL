library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity nand_sr_latch_beh is
    Port (
        s_n  : in  STD_LOGIC;
        r_n  : in  STD_LOGIC;
        q    : out STD_LOGIC;
        qbar : out STD_LOGIC
    );
end nand_sr_latch_beh;

architecture Behavioral of nand_sr_latch_beh is
begin
    process(s_n, r_n)
    begin
        if (s_n = '1' and r_n = '1') then
            null;
        elsif (s_n = '1' and r_n = '0') then
            q    <= '0';
            qbar <= '1';
        elsif (s_n = '0' and r_n = '1') then
            q    <= '1';
            qbar <= '0';
        elsif (s_n = '0' and r_n = '0') then
            q    <= 'X';
            qbar <= 'X';
        end if;
    end process;
end Behavioral;
