library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity d_truth_table is
    Port (
        d    : in  STD_LOGIC;
        q    : out STD_LOGIC;
        qbar : out STD_LOGIC
    );
end d_truth_table;

architecture Behavioral of d_truth_table is
begin
    process(d)
    begin
        if d = '0' then
            q    <= '0';
            qbar <= '1';
        elsif d = '1' then
            q    <= '1';
            qbar <= '0';
        end if;
    end process;
end Behavioral;
