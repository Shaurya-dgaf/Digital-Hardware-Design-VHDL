

library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity half_subtractor is
    Port (
        a      : in  STD_LOGIC;
        b      : in  STD_LOGIC;
        diff   : out STD_LOGIC;
        borrow : out STD_LOGIC
    );
end half_subtractor;

architecture Dataflow of half_subtractor is
begin
    diff   <= a XOR b;
    borrow <= (NOT a) AND b;
end Dataflow;
